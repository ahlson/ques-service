{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ⚠️ 用 Cloudflare 后台「连接 GitHub」部署时，后台里的 Worker 名必须与这里的 name 一致
  "name": "ques-service",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "../public",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ques-service-db",
      "database_id": "760d4d34-95a7-4589-b906-ef3a541ef599",
      "migrations_dir": "migrations"
    }
  ],

  // ⚠️ TOKEN_SECRET 不要写在 vars 里：wrangler 会用这里的明文覆盖掉远端 Secret。
  // 正确做法：npx wrangler secret put TOKEN_SECRET（或后台 Settings → 变量和机密）。

  "observability": {
    "enabled": true
  }
}
