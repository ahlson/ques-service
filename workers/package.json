{
  "name": "ques-service-workers",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "在线答题系统 - Cloudflare Workers 部署（Hono + D1 + 静态资源）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create ques-service-db",
    "d1:migrate": "wrangler d1 migrations apply ques-service-db --remote",
    "d1:migrate:local": "wrangler d1 migrations apply ques-service-db --local",
    "secret": "wrangler secret put TOKEN_SECRET",
    "tail": "wrangler tail",
    "gen:config": "node scripts/gen-wrangler.js",
    "deploy:ci": "node scripts/gen-wrangler.js && wrangler deploy --config wrangler.deploy.jsonc"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^4.141.0"
  }
}
